{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build FTML language server",
      "type": "shell",
      "command": "pnpm run build:server",
      "options": {
        "cwd": "${workspaceFolder}\\extensions\\vscode"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Compile FTML extension",
      "type": "shell",
      "command": "pnpm run compile",
      "options": {
        "cwd": "${workspaceFolder}\\extensions\\vscode"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true,
        "showReuseMessage": false
      },
      "problemMatcher": []
    },
    {
      "label": "Build FTML Extension",
      "dependsOn": [
        "Build FTML language server",
        "Compile FTML extension"
      ],
      "dependsOrder": "sequence",
      "problemMatcher": []
    }
  ]
}
