{
  "name": "scp-foundation-editor-web",
  "version": "2.0.0",
  "private": true,
  "description": "Frontend editor for SCP Foundation Editor (Vue 3 + CodeMirror 6 + ftml WASM)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "format": "prettier --write \"**/*.{ts,vue,scss,css,json,md,html}\""
  },
  "author": "wasd243",
  "license": "AGPL-3.0-only",
  "dependencies": {
    "ftml_handler": "link:ftml_handler/pkg/",
    "monaco-editor": "^0.57.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "prettier": "^3.6.0",
    "rollup": "^4.64.9",
    "sass": "^1.90.0",
    "typescript": "^5.6.3",
    "vite": "^8.3.4",
    "vite-plugin-wasm": "^3.6.0",
    "vue-tsc": "^3.0.0"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=10"
  }
}
