{
  "scopeName": "source.ftml",
  "patterns": [{ "include": "#css-module" }, { "include": "#html-block" }],
  "repository": {
    "css-module": {
      "begin": "(?i)\\[\\[module\\s+css\\s*\\]\\]",
      "end": "(?i)\\[\\[/module\\]\\]",
      "contentName": "meta.embedded.block.css",
      "patterns": [{ "include": "source.css" }]
    },
    "html-block": {
      "begin": "(?i)\\[\\[html[^\\]]*\\]\\]",
      "end": "(?i)\\[\\[/html\\]\\]",
      "contentName": "meta.embedded.block.html",
      "patterns": [{ "include": "text.html.basic" }]
    }
  }
}