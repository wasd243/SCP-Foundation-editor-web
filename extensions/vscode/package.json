{
  "name": "ftml-analyzer",
  "publisher": "wasd243",
  "displayName": "LSP for FTML/Wikidot",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasd243/SCP-Foundation-editor-web"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./out/extension.js",
  "scripts": {
    "check": "tsc -p .",
    "compile": "pnpm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --watch",
    "build:server": "cargo build --manifest-path ../../Cargo.toml --release -p lsp_driver --features highlight && python scripts/build.py stage",
    "check:binaries": "python scripts/build.py check-binaries",
    "package": "pnpm run build:server && pnpm run compile && python scripts/build.py package-local",
    "package:release": "pnpm run check:binaries && pnpm run compile && vsce package --no-dependencies"
  },
  "contributes": {
    "languages": [
      {
        "id": "ftml",
        "extensions": [
          ".ftml",
          ".wj"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ftml",
        "scopeName": "source.ftml",
        "path": "./syntaxes/ftml.tmLanguage.json",
        "embeddedLanguages": {
          "meta.embedded.block.css": "css",
          "meta.embedded.block.html": "html"
        }
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "ftmlBold",
        "description": "Bold text"
      },
      {
        "id": "ftmlItalic",
        "description": "Italic text"
      },
      {
        "id": "ftmlUnderline",
        "description": "Underlined text"
      },
      {
        "id": "ftmlStrike",
        "description": "Struck text"
      },
      {
        "id": "ftmlMonospace",
        "description": "Monospace text"
      },
      {
        "id": "ftmlLinkUrl",
        "description": "Link URL"
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "ftml",
        "scopes": {
          "ftmlBold": [
            "markup.bold"
          ],
          "ftmlItalic": [
            "markup.italic"
          ],
          "ftmlUnderline": [
            "markup.underline"
          ],
          "ftmlStrike": [
            "markup.strikethrough"
          ],
          "ftmlMonospace": [
            "markup.inline.raw"
          ],
          "ftmlLinkUrl": [
            "markup.underline.link"
          ]
        }
      }
    ],
    "configurationDefaults": {
      "[ftml]": {
        "editor.wordWrap": "on"
      }
    },
    "configuration": {
      "properties": {
        "ftml.serverPath": {
          "type": "string",
          "default": "",
          "description": "Override the bundled ftml_analyzer binary."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.2.1",
    "@types/node": "^26.6.7",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.0.0"
  }
}
