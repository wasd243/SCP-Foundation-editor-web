{
  "name": "ftml-analyzer",
  "publisher": "wasd243",
  "displayName": "LSP server for FTML/Wikidot (no highlight)",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/wasd243/SCP-Foundation-editor-web"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onLanguage:ftml"
  ],
  "main": "./out/extension.js",
  "scripts": {
    "check": "tsc -p .",
    "compile": "pnpm run check && esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js",
    "watch": "esbuild src/extension.ts --bundle --platform=node --format=cjs --external:vscode --outfile=out/extension.js --watch",
    "build:server": "cargo buildlsp --manifest-path ../../Cargo.toml && python scripts/build.py stage",
    "check:binaries": "python scripts/build.py check-binaries",
    "package": "pnpm run build:server && pnpm run compile && python scripts/build.py package-local",
    "package:release": "pnpm run check:binaries && pnpm run compile && python scripts/build.py package-release"
  },
  "contributes": {
    "configuration": {
      "properties": {
        "ftml.serverPath": {
          "type": "string",
          "default": "",
          "description": "Override the bundled ftml_analyzer binary."
        }
      }
    }
  },
  "dependencies": {
    "vscode-languageclient": "^11.0.1"
  },
  "devDependencies": {
    "@vscode/vsce": "^4.1.1",
    "@types/node": "^26.6.7",
    "@types/vscode": "^1.90.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.0.0"
  }
}
